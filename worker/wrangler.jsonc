{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frameforge-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Every invocation is kept. Sampling below 1 would make the hit rate and the
  // prewarm failure count estimates rather than counts, and at this request
  // volume the whole stream fits inside the plan's included ingest.
  //
  // `invocation_logs` stays on despite each request already writing a line of
  // its own: the runtime's own line is what carries an uncaught exception and
  // its stack, which is how a tick dying inside the prewarm becomes visible at
  // all.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },

  // Holds the price snapshot and the prewarm cursor. Both are public,
  // item-keyed data: nothing here is per user.
  "kv_namespaces": [{ "binding": "SNAPSHOT", "id": "7e307879054f4a059bf00d00450adfe2" }],

  // The daily request counter. It has to be one number across every edge
  // location, which KV's eventual consistency cannot give.
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],

  // Twelve ticks an hour, which is what lets 42 hot items a tick carry the
  // 500-item hot set round inside the hour a price stays fresh. Every
  // invocation gets its own subrequest allowance, so ticking more often would
  // raise throughput further — but the batch below is already limited by what
  // warframe.market should be asked for, not by the allowance.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // Requests served per UTC day before the worker stands down and clients go
    // back to the upstreams direct. Well inside what the plan allows, so this
    // is a spend ceiling rather than a platform one: it bounds what a bug or an
    // abusive caller can cost, and the fallback that follows is a deliberate
    // one rather than a wall of platform errors.
    "DAILY_REQUEST_BUDGET": 100000,

    // Subrequests one invocation may make: 1000 on the paid plan, 50 on free.
    // Every fetch and every Cache API match or put counts against it, and the
    // runtime throws on the one past the limit rather than waiting, so a tick
    // stops itself short of the ceiling and says so in its log line. Dropping to
    // the free plan means dropping this to 50 and the batch to about 15.
    "PREWARM_SUBREQUEST_CEILING": 1000,

    // Items refreshed per cron tick, and how many of those go to the hot lane.
    // A price costs three subrequests, so 240 spends 724 of the 1000 and leaves
    // a quarter of the allowance for a catalog fetch and a slow item rather than
    // running the tick up against the ceiling.
    //
    // 42 hot every five minutes laps a 500-item hot set in ~59 minutes, inside
    // the hour a statistics body stays fresh; the remaining 198 lap a ~3840-item
    // catalog in about an hour and 40. Together that is one request to
    // warframe.market every 1.25 seconds across the tick.
    "PREWARM_BATCH_SIZE": 240,
    "PREWARM_HOT_BATCH_SIZE": 42,

    // How many of the busiest items count as hot. Large enough to hold
    // everything anybody trades in volume, small enough to lap within the
    // statistics freshness.
    "PREWARM_HOT_SIZE": 500
  }
}
