{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frameforge-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Holds the price snapshot and the prewarm cursor. Both are public,
  // item-keyed data: nothing here is per user.
  // TODO: `id` is a placeholder until the namespace is created against the
  // Cloudflare account (`wrangler kv namespace create snapshot`).
  "kv_namespaces": [{ "binding": "SNAPSHOT", "id": "7e307879054f4a059bf00d00450adfe2" }],

  // The daily request counter. It has to be one number across every edge
  // location, which KV's eventual consistency cannot give.
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],

  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // Requests served per UTC day before the worker stands down and clients go
    // back to the upstreams direct. The free plan's own daily ceiling, so the
    // brake trips before the platform does and the fallback is a deliberate
    // one rather than a wall of platform errors.
    "DAILY_REQUEST_BUDGET": 100000,

    // Items refreshed per cron tick. 60 every 5 minutes is one upstream request
    // every 5 seconds — well under what warframe.market tolerates — and walks a
    // ~4000-item catalog end to end in about five hours, which is how stale the
    // oldest price in the snapshot can be.
    "PREWARM_BATCH_SIZE": 60
  }
}
